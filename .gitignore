# Studio React build output: index.html + assets are committed so the git-connected Pages
# build serves /studio/ (the project has no build step). Regenerate with `npm run build:studio`.
# Ignore only the heavy sourcemaps.
public/studio/assets/*.map

# Build artifact — regenerated by `wrangler pages functions build`. NOT the deploy input
# (wrangler.toml sets pages_build_output_dir = "public"), and every parallel agent that runs a
# build rewrites it, producing noisy conflicting diffs.
_worker.bundle
