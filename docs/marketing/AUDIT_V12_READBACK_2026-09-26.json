          "rendered_text": [
            {
              "role": "eyebrow",
              "text": "LA CAJITA · PERSONALIZATION"
            },
            {
              "role": "headline",
              "text": "Make it yours."
            },
            {
              "role": "row_heading",
              "text": "START WITH SIX / SEIS FAVORITOS",
              "product_claim_id": "pc_fcb8c91443099d51980cd6dd0caf7f88cc04449a675427bbcfc1d51706061cd7_2"
            },
            {
              "role": "row_body",
              "text": "Hawaiian roll with ham spread; guava-cheese empanada; ham croqueta; creamy macaroni salad; fruit, ham, guava, cheese and pineapple skewer; tres leches cup.",
              "product_claim_id": "pc_fcb8c91443099d51980cd6dd0caf7f88cc04449a675427bbcfc1d51706061cd7_3"
            },
            {
              "role": "row_heading",
              "text": "YOUR MENU / TU MENÚ"
            },
            {
              "role": "row_body",
              "text": "Request flavors, quantities, additions or removals. Tell us dietary needs for review."
            },
            {
              "role": "row_heading",
              "text": "YOUR PRESENTATION / TU PRESENTACIÓN"
            },
            {
              "role": "row_body",
              "text": "Choose colors, liners, labels, tags, packaging and finishing touches. Share your theme, wording or invitation."
            },
            {
              "role": "detail",
              "text": "Photos show design possibilities, not a fixed assortment.\nMenú y personalización sujetos a cotización."
            }
