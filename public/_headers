# Cloudflare Pages security headers. Applied to every response.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), microphone=(self), camera=(self), payment=(self)
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: https://*.squarecdn.com https://www.google-analytics.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://*.squarecdn.com; font-src 'self' https://fonts.gstatic.com https://*.squarecdn.com; script-src 'self' 'unsafe-inline' https://*.squarecdn.com https://js.squareup.com https://js.squareupsandbox.com https://www.googletagmanager.com; frame-src https://*.squarecdn.com https://connect.squareup.com https://connect.squareupsandbox.com; connect-src 'self' https://*.squareup.com https://*.squareupsandbox.com https://*.squarecdn.com https://o160250.ingest.sentry.io https://www.google-analytics.com https://*.google-analytics.com https://www.googletagmanager.com; form-action 'self'

# ---------------------------------------------------------------------------------------------
# HUB assets must never be stale. They are UNVERSIONED (`/hub/assets/hub.css`, no ?v= or content
# hash), and Pages' default `max-age=14400` meant a phone kept them for FOUR HOURS after a deploy.
# The failure that caused is worse than a slow load: the HTML is served fresh while the CSS and JS
# are four hours old, so the owner sees NEW markup styled by OLD rules — a half-broken layout that
# looks like a botched release and cannot be reproduced by whoever shipped it. That is exactly how
# the 2026-08-04 "the marketing team is all discombobulated" report happened.
#
# `no-cache` does NOT mean "don't cache" — it means "cache, but revalidate before every use." The
# browser keeps the file and sends an If-None-Match; an unchanged asset costs one 304 with an
# empty body. That is the right trade for an internal app used by a handful of staff.
# Content-hashed bundles (the Studio build under /studio/assets) are exempt below: their name
# changes when their content does, so they are safe to cache hard and forever.
/hub/assets/*
  Cache-Control: no-cache

/hub/owner/assets/*
  Cache-Control: no-cache

/hub/driver/assets/*
  Cache-Control: no-cache

/hub/kitchen/assets/*
  Cache-Control: no-cache

/assets/js/i18n.js
  Cache-Control: no-cache

# Studio's Vite bundle IS content-hashed (assets/index-<hash>.js) — immutable is correct here.
/studio/assets/*
  Cache-Control: public, max-age=31536000, immutable
